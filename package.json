{
  "name": "theme-nucma",
  "type": "module",
  "version": "1.0.1",
  "description": "面向全国高校自媒体联盟的 Halo 主题，聚焦组织公示、校园资讯与成员展示",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/update-version.js patch && node scripts/build.js && vite build && node scripts/manual-package.js",
    "build:manual": "node scripts/build.js && vite build && cmd /c manual-package.bat",
    "dev": "vite build --watch",
    "version": "node scripts/update-version.js",
    "version:patch": "node scripts/update-version.js patch",
    "version:minor": "node scripts/update-version.js minor",
    "version:major": "node scripts/update-version.js major",
    "release:patch": "node scripts/update-version.js patch && pnpm build",
    "release:minor": "node scripts/update-version.js minor && pnpm build",
    "release:major": "node scripts/update-version.js major && pnpm build"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.0.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.1.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.0.0",
    "vite-plugin-html": "^3.2.2"
  }
}
