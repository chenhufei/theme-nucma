{
    "name": "theme-nucma",
    "version": "3.34.10",
    "description": "面向校园、青年组织与公共服务门户的多风格 Halo 主题，提供专题模板与响应式阅读体验",
    "license": "GPL-3.0-only",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite build --watch",
        "check": "node tools/verify-theme.mjs",
        "build": "npm run check && vite build && node tools/verify-theme.mjs --built",
        "package": "npm run build && theme-package && node tools/verify-package.mjs"
    },
    "devDependencies": {
        "@halo-dev/theme-package-cli": "1.1.1",
        "@tailwindcss/postcss": "4.3.3",
        "adm-zip": "^0.6.0",
        "daisyui": "5.7.16",
        "esbuild": "0.28.2",
        "js-yaml": "5.2.3",
        "postcss": "8.5.26",
        "tailwindcss": "4.3.3",
        "vite": "8.2.1"
    },
    "keywords": [
        "halo",
        "halo-theme",
        "nucma",
        "校园主题",
        "组织门户",
        "公益主题"
    ],
    "author": "NUCMA",
    "homepage": "https://nucma.cn",
    "dependencies": {
        "pinyin-pro": "3.29.1",
        "qrcode": "1.5.4"
    }
}
