{
    "name":  "theme-nucma",
    "version":  "3.33.4",
    "description":  "面向校园、青年组织与公共服务门户的多风格 Halo 主题，提供专题模板与响应式阅读体验",
    "license":  "GPL-3.0-only",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "scripts":  {
                    "dev":  "vite build --watch",
                    "check":  "node tools/verify-theme.mjs",
                    "build":  "npm run check \u0026\u0026 vite build \u0026\u0026 node tools/verify-theme.mjs --built",
                    "package":  "npm run build \u0026\u0026 theme-package \u0026\u0026 node tools/verify-package.mjs"
                },
    "devDependencies":  {
                            "@halo-dev/theme-package-cli":  "1.1.1",
                            "@tailwindcss/postcss":  "4.3.3",
                            "adm-zip":  "^0.6.0",
                            "daisyui":  "5.7.16",
                            "esbuild":  "^0.28.1",
                            "js-yaml":  "^5.2.2",
                            "postcss":  "^8.4.0",
                            "tailwindcss":  "4.3.3",
                            "vite":  "^8.2.0"
                        },
    "keywords":  [
                     "halo",
                     "halo-theme",
                     "nucma",
                     "校园主题",
                     "组织门户",
                     "公益主题"
                 ],
    "author":  "NUCMA",
    "homepage":  "https://nucma.cn",
    "dependencies":  {
                         "pinyin-pro":  "3.16.4",
                         "qrcode":  "1.5.4"
                     }
}
